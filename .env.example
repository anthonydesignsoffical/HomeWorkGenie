# Local development example only. Do not commit real secrets.
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password

# Optional SMTP configuration. Required for real password-reset/email delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Homework Genie <admin@example.com>"
ADMIN_NOTIFICATION_EMAIL=admin@example.com
